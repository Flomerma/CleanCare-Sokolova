# Kopie dieser Datei als .env.local anlegen und Werte eintragen.
# In Vercel: Project Settings → Environment Variables.

# --- Website ---
# TODO: Nach dem Deployment durch die echte Domain ersetzen
NEXT_PUBLIC_SITE_URL=https://cleancare-sokolova.vercel.app

# --- Admin-Bereich (/admin) ---
# TODO: Sicheres Passwort setzen
ADMIN_PASSWORD=PLATZHALTER_PASSWORT
# Zufälliger Wert zum Signieren des Session-Cookies (z.B. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# --- E-Mail-Versand (optional) ---
# Solange SMTP_HOST leer ist, werden keine E-Mails versendet (nur Server-Logs).
# TODO: Echte SMTP-Zugangsdaten eintragen
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CleanCare Sokolova <noreply@example.com>"

# --- Supabase (später) ---
# TODO: Nach dem Anlegen des Supabase-Projekts ausfüllen
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
